{
  "name": "project-civitas",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "benchmark": "tsx scripts/benchmark.ts",
    "stability": "tsx scripts/stability.ts",
    "desktop": "electron .",
    "package:win": "pnpm build && pwsh -NoProfile -File scripts/stage-desktop.ps1 && electron-builder --projectDir .desktop-runtime --win dir portable",
    "qa:desktop": "tsx scripts/desktop-qa.ts",
    "qa:scene": "tsx scripts/scene-qa.ts"
  },
  "main": "apps/desktop/electron/main.cjs",
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pixi.js": "^8.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9.0.0",
    "playwright": "^1.55.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "studio.civitas.observatory",
    "productName": "Project CIVITAS",
    "directories": {
      "output": "release/0.1.1",
      "app": ".desktop-runtime"
    },
    "files": [
      "dist/**/*",
      "apps/desktop/electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "dir",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "CIVITAS-${version}-Windows-portable.exe"
    },
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false
  },
  "description": "A deterministic, verifiable living city observatory",
  "author": "CIVITAS"
}
